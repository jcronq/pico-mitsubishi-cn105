# Copy to .env (gitignored) and fill in. All env vars are read on process start.

# Base URL of the Pico firmware. mDNS "barn-minisplit.local" works if the host
# resolves .local; otherwise use the Pico's LAN IP or DHCP-reserved hostname.
MITSUBISHI_URL=http://barn-minisplit.local

# HTTP timeout in seconds. The Pico is on the LAN so 2-3s is usually fine; 5
# gives slack for occasional wifi roam.
MITSUBISHI_TIMEOUT=5.0
